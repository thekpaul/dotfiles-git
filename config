[init]
	defaultBranch = main
[core]
	editor = nvim
[commit]
	gpgsign = true
	verbose = true
[pull]
	rebase = true
[merge]
	autostash = true
[rebase]
	autostash = true
[push]
	default = simple
[help]
	autocorrect = 10
[alias]
	fix-commit = "!sh -c 'git commit --edit --file=\"$(git rev-parse --git-path COMMIT_EDITMSG)\" \"$@\"' _"
	rst-commit = commit --reedit-message=HEAD --reset-author
[pretty]
	simple = %C(auto)%h%d%Creset %s%n  %C(cyan)>> Committed on %cd by %cn <%ce> <<%Creset%n  %C(yellow)>> Signature: %G? (key %GK) <<%Creset
	expand = %C(auto)%h%d%Creset %s%n  %C(cyan)>> Committed on %cd by %cn <%ce> <<%Creset%n  %C(magenta)>> Authored  on %ad by %an <%ae> <<%Creset%n  %C(yellow)>> Signature: %G? (key %GK, signer %GS) <<%Creset
